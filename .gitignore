# PASTABA: .gitignore nepalaiko komentaru eilutes gale.
# Komentaras po sablono tampa sablono dalimi ir jis nustoja veikti.
# Visi komentarai cia - atskirose eilutese.

# ─── Duomenys ────────────────────────────────────────────────
duomenys/raw/
duomenys/processed/
*.parquet
*.pcap

# Visi CSV ignoruojami...
*.csv
# ...isskyrus eksperimentu metrikas - jos mazos ir jas verta versijuoti
!rezultatai/rezultatai.csv

# ─── Apmokyti modeliai ───────────────────────────────────────
rezultatai/apmokyti/*
# Metaduomenys lieka - hiperparametrai ir duomenu versija butini atkartojamumui
!rezultatai/apmokyti/metadata.json
*.pkl
*.joblib
*.h5
*.keras
*.pt
*.pth

# ─── LaTeX tarpiniai failai ──────────────────────────────────
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.bcf
*.blg
*.run.xml
*.synctex.gz
*.fdb_latexmk
*.fls
*.nav
*.snm
*.vrb

# Sukompiliuota ataskaita - generuojama is saltiniu.
# Jei norite versijuoti PDF istorija, istrinkite sia eilute.
ataskaita/ataskaita.pdf

# ─── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# ─── Eksperimentu sekimas ────────────────────────────────────
mlruns/
.optuna/
wandb/

# ─── OS / IDE ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
